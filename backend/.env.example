# ---- Runtime ----
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8080
API_V1_PREFIX=/api/v1

# ---- Kingbase (PostgreSQL 兼容) ----
# 开发用 postgres:15-alpine 占位；上线替换为 Kingbase ES 真实地址
# 端口 54322：本机若已有 Kingbase ES 服务占用 54321，docker-compose 映射到 54322 避让
DATABASE_URL=postgresql+asyncpg://sip_user:sip_pass_dev@localhost:54322/sip_db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---- Redis ----
REDIS_URL=redis://:sip_redis_dev@localhost:6379/0

# ---- MinIO ----
# 端口 9010：避开本机 9000 可能的 Python/其它服务占用，docker-compose 外部映射 9010→9000
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=sip_minio
MINIO_SECRET_KEY=sip_minio_dev
MINIO_SECURE=false
MINIO_BUCKET_ATTACHMENT=sip-attachments
MINIO_BUCKET_TEMPLATE=sip-templates
MINIO_BUCKET_EXPORT=sip-exports

# ---- Security / JWT ----
# 生产环境务必更换；至少 32 字节随机字符串
JWT_SECRET_KEY=change-me-in-production-please-use-random-32bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Field encryption (敏感字段 AES/Fernet) ----
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=2tTqAlzPdUU2GzGD6BCXq5q8SWHLqULfGjzktKh9jrw=

# ---- 微信小程序 ----
WECHAT_APPID=
WECHAT_SECRET=
# 开发阶段 mock 模式，不调用真实微信 API
WECHAT_MOCK_ENABLED=true

# ---- 受控 AI 问答 (Anthropic) ----
AI_QA_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- 邮件 (MailHog 开发) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@sip.example.edu

# ---- 短信 (一期开关默认关闭) ----
SMS_ENABLED=false
SMS_PROVIDER=
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN=

# ---- 上传限制 ----
UPLOAD_MAX_SIZE_MB=30
