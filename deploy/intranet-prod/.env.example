# ---- Deployment identity ----
COMPOSE_PROJECT_NAME=super-ruc-intranet-prod
WEB_HTTP_PORT=80

# ---- Images ----
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:15-alpine
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
MINIO_IMAGE=docker.m.daocloud.io/minio/minio:latest
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
NODE_IMAGE=docker.m.daocloud.io/library/node:20-bookworm-slim
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine

# ---- Build proxy for intranet servers without direct egress ----
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=localhost,127.0.0.1,::1,db,redis,minio,backend,web

# ---- PostgreSQL 15 compatible database ----
POSTGRES_DB=sip_db
POSTGRES_USER=sip_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://sip_app:REPLACE_WITH_URL_ENCODED_POSTGRES_PASSWORD@db:5432/sip_db
KINGBASE_DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---- Redis ----
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_REDIS_PASSWORD@redis:6379/0

# ---- MinIO ----
MINIO_ROOT_USER=sip_minio
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_MINIO_PASSWORD
MINIO_BUCKET_ATTACHMENT=sip-attachments
MINIO_BUCKET_TEMPLATE=sip-templates
MINIO_BUCKET_EXPORT=sip-exports

# ---- Backend runtime ----
AUDIT_ARCHIVE_ENABLED=false
AUDIT_ARCHIVE_RUN_AT=03:30
AUDIT_ARCHIVE_RETENTION_DAYS=180
AUDIT_ARCHIVE_BATCH_SIZE=1000
AUDIT_ARCHIVE_LOCK_TTL_SECONDS=3600
WORKFLOW_REMINDER_ENABLED=true
WORKFLOW_REMINDER_INTERVAL_MINUTES=60
WORKFLOW_REMINDER_LOCK_TTL_SECONDS=1800
UPLOAD_MAX_SIZE_MB=30

# ---- Security; never commit real values ----
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_48_BYTES_OR_LONGER
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
FIELD_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# ---- WeChat; production guard requires these in APP_ENV=prod ----
WECHAT_APPID=REPLACE_WITH_WECHAT_APPID
WECHAT_SECRET=REPLACE_WITH_WECHAT_SECRET
WECHAT_GUEST_LOGIN_ENABLED=false
WECHAT_SUBSCRIBE_ENABLED=false
WECHAT_SUBSCRIBE_REMINDER_TEMPLATE_ID=
WECHAT_SUBSCRIBE_REQUEST_TEMPLATE_ID=

# ---- Optional integrations ----
# 知识问答当前只做检索式回答，生产默认不启用生成式 AI
AI_QA_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@sip.example.edu
